DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=pitchaside
PORT=3001
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Email. With neither block below set, emails are only logged (fine for dev).
# MAIL_FROM must be an address on the domain you verified with ZeptoMail.
#
# ZeptoMail HTTPS API — use this in production. Railway blocks outgoing SMTP on
# every plan below Pro, so the SMTP block below never connects there.
# ZEPTOMAIL_TOKEN = the "Send Mail Token" from your Mail Agent's API tab
# (with or without its "Zoho-enczapikey " prefix). If your ZeptoMail account is
# on a regional data centre, copy the URL the API tab shows into ZEPTOMAIL_API_URL.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# SMTP — used only when ZEPTOMAIL_TOKEN is empty. Any provider, where the port is open.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=PitchAside <hi@pitchaside.com>

# Frontend URL (used in email links)
APP_URL=http://localhost:3000

# PulseMFB (group collection accounts)
# mock = local fake accounts + /groups/:id/transfers/simulate; live = real PulseMFB API
PULSE_MODE=mock
PULSE_BASE_URL=https://api.pulsemfb.com
PULSE_PUBLIC_KEY=
PULSE_PRIVATE_KEY=
PULSE_WEBHOOK_SECRET=dev-webhook-secret

# WhatsApp / SMS — only used when NOTIFY_FALLBACK=whatsapp. mock = store in the outbox, send nothing
MESSAGING_MODE=mock
MESSAGING_OTP_CHANNEL=whatsapp
TERMII_API_KEY=
TERMII_SENDER_ID=PitchAside

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@pitchaside.app

# Players sign in with email + password. Password codes and (with NOTIFY_FALLBACK=email)
# notifications go out through the SMTP settings above.

# Notifications when a player has no push: none = push only, email = email them (needs SMTP above
# and the player's email address), whatsapp = WhatsApp/SMS
NOTIFY_FALLBACK=none
# Reminder times (6pm day before, 2h before kick-off, 9am after) use this zone
APP_TIMEZONE=Africa/Lagos
